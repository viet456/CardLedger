{
    "name": "cardledger",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "check-env": "echo $DATABASE_URL",
        "dev": "next dev --turbopack",
        "build": "prisma generate && next build --turbopack",
        "build:analyze": "prisma generate && next experimental-analyze",
        "start": "next start",
        "test": "vitest",
        "lint": "eslint",
        "typecheck": "tsc --noEmit",
        "prepare": "husky install",
        "prettier": "prettier --write .",
        "db:generate": "prisma generate",
        "db:populate": "pnpm run db:generate && tsx scripts/populate.ts",
        "db:populate:force": "pnpm run db:generate && tsx scripts/populate.ts --force",
        "db:backfill-pokedex": "tsx scripts/backfillPokedexSort.ts",
        "db:backfill-release-date": "tsx scripts/backfillReleaseDate.ts",
        "db:backfill-tcg": "tsx scripts/backfillTcgPlayerSetIds.ts",
        "db:clear-setid": "tsx scripts/clearSetIds.tsx",
        "db:migrate-setid": "tsx scripts/migrateToNumericIds.ts",
        "db:backfill-price": "tsx scripts/backfillPriceHistory.ts",
        "db:update-market": "tsx scripts/updateMarketStats.ts",
        "db:sync": "pnpm run db:populate && pnpm run images:migrate",
        "index:cards": "tsx scripts/generateCardIndex.ts",
        "index:market": "tsx scripts/generateMarketIndex.ts",
        "index:history": "tsx scripts/generateHistoryIndex.ts",
        "optimize:images": "tsx scripts/optimizeImages.ts",
        "maintain-images": "tsx scripts/imgMaintenance.ts"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1156.0",
        "@aws-sdk/lib-storage": "^3.1156.0",
        "@leeoniya/ufuzzy": "^1.0.19",
        "@marsidev/react-turnstile": "^1.6.3",
        "@neondatabase/serverless": "^1.2.0",
        "@prisma/adapter-pg": "^7.10.1",
        "@prisma/client": "^7.10.1",
        "@radix-ui/react-alert-dialog": "^1.2.1",
        "@radix-ui/react-avatar": "^1.3.1",
        "@radix-ui/react-dialog": "^1.3.1",
        "@radix-ui/react-dropdown-menu": "^2.2.1",
        "@radix-ui/react-label": "^2.1.17",
        "@radix-ui/react-popover": "^1.3.1",
        "@radix-ui/react-select": "^2.4.1",
        "@radix-ui/react-separator": "^1.2.0",
        "@radix-ui/react-slot": "^1.5.0",
        "@radix-ui/react-tabs": "^1.2.1",
        "@radix-ui/react-tooltip": "^1.4.1",
        "@smithy/node-http-handler": "^4.12.1",
        "@tanstack/react-query": "^5.104.5",
        "@tanstack/react-table": "^8.21.3",
        "@tcgdex/sdk": "^2.9.0",
        "@trpc/client": "^11.19.0",
        "@trpc/react-query": "^11.19.0",
        "@trpc/server": "^11.19.0",
        "@trpc/tanstack-react-query": "^11.19.0",
        "@uidotdev/usehooks": "^2.4.1",
        "@vercel/analytics": "^1.6.1",
        "@vercel/speed-insights": "^1.3.1",
        "better-auth": "^1.7.12",
        "chart.js": "^4.6.1",
        "chartjs-adapter-date-fns": "^3.0.0",
        "class-variance-authority": "^0.7.1",
        "client-only": "^0.0.1",
        "clsx": "^2.1.1",
        "date-fns": "^4.4.0",
        "idb-keyval": "^6.3.0",
        "lucide-react": "^0.577.0",
        "next": "16.4.3",
        "next-themes": "^0.4.6",
        "p-limit": "^7.3.3",
        "pg": "^8.23.1",
        "radix-ui": "^1.8.1",
        "react": "19.3.1",
        "react-day-picker": "^9.14.0",
        "react-dom": "19.3.1",
        "react-intersection-observer": "^9.16.0",
        "react-virtuoso": "^4.18.19",
        "resend": "^6.34.1",
        "server-only": "^0.0.1",
        "sharp": "^0.35.5",
        "sonner": "^2.0.8",
        "superjson": "^2.2.6",
        "tailwind-merge": "^3.7.0",
        "vaul": "^1.1.2",
        "zod": "^4.6.7",
        "zustand": "^5.0.16"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.7",
        "@serwist/turbopack": "^9.5.13",
        "@tailwindcss/typography": "^0.5.20",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/react": "^16.3.3",
        "@tsconfig/recommended": "^1.0.13",
        "@types/node": "^20.19.43",
        "@types/pg": "^8.23.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^5.2.0",
        "autoprefixer": "^10.6.1",
        "axios": "^1.20.0",
        "dotenv": "^17.4.2",
        "dotenv-cli": "^10.0.0",
        "esbuild": "^0.28.2",
        "eslint": "^9.39.5",
        "eslint-config-next": "16.4.3",
        "eslint-config-prettier": "^10.1.8",
        "husky": "^8.0.3",
        "jsdom": "^27.4.0",
        "lint-staged": "^16.4.0",
        "node-fetch": "^3.3.2",
        "postcss": "^8.5.31",
        "prettier": "^3.9.10",
        "prettier-plugin-prisma": "^5.0.0",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "prisma": "^7.10.1",
        "serwist": "^9.5.13",
        "tailwindcss": "^3.4.19",
        "tailwindcss-animate": "^1.0.7",
        "tsx": "^4.23.15",
        "tw-animate-css": "^1.4.0",
        "typescript": "^5.9.3",
        "vite-tsconfig-paths": "^5.1.4",
        "vitest": "^3.2.7"
    },
    "lint-staged": {
        "*.{js, jsx,ts,tsx}": [
            "eslint --quiet --fix"
        ],
        "*.{json,js,ts,jsx,tsx,html}": [
            "prettier --write --ignore-unknown"
        ]
    }
}
